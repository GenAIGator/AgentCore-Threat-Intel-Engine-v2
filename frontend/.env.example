# Frontend environment template.
#
# deploy.sh writes the real frontend/.env from the CloudFormation stack outputs at deploy
# time — you normally do NOT edit this by hand. This .env.example documents the variables
# the SPA expects. Copy to `.env` and fill in your own stack's values if running locally.
#
# All values below are PLACEHOLDERS — replace with your own account/stack outputs.

# AgentCore Runtime invocations endpoint (URL-encoded runtime ARN + DEFAULT qualifier).
VITE_AGENTCORE_ENDPOINT=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A123456789012%3Aruntime%2FYourStack_ThreatIntelAgent-abc123/invocations?qualifier=DEFAULT

# Cognito Hosted UI domain (without protocol).
VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com

# Cognito app client id (public SPA client).
VITE_COGNITO_CLIENT_ID=your-app-client-id

# OAuth redirect URI (your CloudFront/site URL + /callback).
VITE_COGNITO_REDIRECT_URI=https://your-distribution.cloudfront.net/callback

# Cognito user pool id.
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
